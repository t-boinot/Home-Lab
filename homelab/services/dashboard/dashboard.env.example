# Copier en /etc/dashboard.env dans le LXC 104, puis : chmod 600 /etc/dashboard.env
PVE_URL=https://192.168.1.18:8006
PVE_NODE=pve-01
# Format : utilisateur!nom-du-jeton=secret (jeton PVEAuditor, voir docs/proxmox.md)
PVE_TOKEN=dashboard@pve!tablet=COLLE-LE-SECRET-ICI
# Appareils à surveiller par ping : Nom=IP séparés par des virgules
PING_TARGETS=Box=192.168.1.254,Proxmox=192.168.1.18
DASHBOARD_PORT=8080
# Délai par défaut (secondes) avant qu'un agent silencieux passe en orange
AGENT_TIMEOUT=300
